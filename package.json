{
	"name": "queues",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"dev:rest": "turbo run dev --filter=!task-service",
		"dev:task": "turbo run dev --filter=task-service",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"check-types": "turbo run check-types",
		"diagram-fanout": "d2 docs/event-flow-fanout.d2 docs/event-flow-fanout.svg",
		"diagram-topic": "d2 docs/event-flow-topic.d2 docs/event-flow-topic.svg",
		"docker:up": "docker compose -f docker/docker-compose.yml up -d",
		"docker:down": "docker compose -f docker/docker-compose.yml down",
		"prepare": "node -e \"if (!process.env.CI) { require('child_process').execSync('lefthook install', { stdio: 'inherit' }) }\""
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"lefthook": "^2.1.10",
		"turbo": "^2.9.6",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.18.0"
	}
}
