# RabbitMQ fanout flow — comparison only, not what the code uses
# Render: pnpm diagram-fanout
# Watch:  d2 -w docs/event-flow-fanout.d2 docs/event-flow-fanout.svg

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 300
  }
}

direction: right

classes: {
  happy: {
    style: {
      animated: true
      stroke-width: 2
    }
  }
  retry: {
    style: {
      stroke-dash: 5
      stroke: "#b45309"
      font-color: "#b45309"
    }
  }
  dlq: {
    style: {
      stroke-dash: 3
      stroke: "#b91c1c"
      font-color: "#b91c1c"
    }
  }
  service: {
    shape: hexagon
  }
  exchange: {
    shape: hexagon
    style: {
      fill: "#e0e7ff"
    }
  }
  workq: {
    shape: queue
  }
  deadq: {
    shape: queue
    style: {
      fill: "#fee2e2"
      stroke: "#b91c1c"
    }
  }
  delay: {
    shape: oval
    style: {
      fill: "#fef3c7"
      stroke: "#b45309"
    }
  }
}

client: {
  shape: person
  label: Client
}

gateway: api-gateway {
  class: [service]
}

rmq: RabbitMQ {
  exchanges: Exchanges {
    default: "amq.default\n(direct)" {
      class: [exchange]
    }
    fanout: "projects.fanout\n(fanout)" {
      class: [exchange]
    }
  }

  project: "project (quorum)" {
    q: project_queue {
      class: [workq]
    }
    svc: project-service {
      class: [service]
    }
    retry: "delayed retry\n5s × 3" {
      class: [delay]
    }
    dead: project_dlq {
      class: [deadq]
    }

    q -> svc: consume project_created {
      class: [happy]
    }
    q -> retry: reject requeue {
      class: [retry]
    }
    retry -> q: redeliver {
      class: [retry]
    }
    q -> dead: "DLE amq.default\nrk=project_dlq" {
      class: [dlq]
    }
  }

  task: "task (quorum)" {
    q: task_queue {
      class: [workq]
    }
    svc: task-service {
      class: [service]
    }
    retry: "delayed retry\n5s × 3" {
      class: [delay]
    }
    dead: task_dlq {
      class: [deadq]
    }

    q -> svc: consume project_created {
      class: [happy]
    }
    q -> retry: reject requeue {
      class: [retry]
    }
    retry -> q: redeliver {
      class: [retry]
    }
    q -> dead: "DLE amq.default\nrk=task_dlq" {
      class: [dlq]
    }
  }

  notification: "notification (quorum)" {
    q: notification_queue {
      class: [workq]
    }
    svc: notification-service {
      class: [service]
    }
    retry: "delayed retry\n5s × 3" {
      class: [delay]
    }
    dead: notification_dlq {
      class: [deadq]
    }

    q -> svc: "consume project_created\nconsume task_created" {
      class: [happy]
    }
    q -> retry: reject requeue {
      class: [retry]
    }
    retry -> q: redeliver {
      class: [retry]
    }
    q -> dead: "DLE amq.default\nrk=notification_dlq" {
      class: [dlq]
    }
  }
}

client -> gateway: POST /api/project {
  class: [happy]
}

gateway -> rmq.exchanges.default: emit project_created {
  class: [happy]
}
rmq.exchanges.default -> rmq.project.q: rk=project_queue {
  class: [happy]
}

rmq.project.svc -> rmq.exchanges.fanout: publishFanout\nproject_created {
  class: [happy]
}
rmq.exchanges.fanout -> rmq.task.q: bind "" {
  class: [happy]
}
rmq.exchanges.fanout -> rmq.notification.q: bind "" {
  class: [happy]
}

rmq.task.svc -> rmq.exchanges.default: emit task_created {
  class: [happy]
}
rmq.exchanges.default -> rmq.notification.q: rk=notification_queue {
  class: [happy]
}
