# RabbitMQ event flow — client → last worker, with exchanges, retry, DLQ
# Render: pnpm diagram
# Watch:  d2 -w docs/event-flow.d2 docs/event-flow.svg

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 300
  }
}

direction: right

classes: {
  happy: {
    style: {
      animated: true
      stroke-width: 2
    }
  }
  retry: {
    style: {
      stroke-dash: 5
      stroke: "#b45309"
      font-color: "#b45309"
    }
  }
  dlq: {
    style: {
      stroke-dash: 3
      stroke: "#b91c1c"
      font-color: "#b91c1c"
    }
  }
  service: {
    shape: hexagon
  }
  exchange: {
    shape: hexagon
    style: {
      fill: "#e0e7ff"
    }
  }
  workq: {
    shape: queue
  }
  deadq: {
    shape: queue
    style: {
      fill: "#fee2e2"
      stroke: "#b91c1c"
    }
  }
  delay: {
    shape: oval
    style: {
      fill: "#fef3c7"
      stroke: "#b45309"
    }
  }
}

client: {
  shape: person
  label: Client
}

gateway: api-gateway {
  class: [service]
}

rmq: RabbitMQ {
  exchanges: Exchanges {
    default: "amq.default\n(direct)" {
      class: [exchange]
    }
    fanout: "orders.fanout\n(fanout)" {
      class: [exchange]
    }
  }

  order: "order (quorum)" {
    q: order_queue {
      class: [workq]
    }
    svc: order-service {
      class: [service]
    }
    retry: "delayed retry\n5s × 3" {
      class: [delay]
    }
    dead: order_dlq {
      class: [deadq]
    }

    q -> svc: consume order_created {
      class: [happy]
    }
    q -> retry: reject requeue {
      class: [retry]
    }
    retry -> q: redeliver {
      class: [retry]
    }
    q -> dead: "DLE amq.default\nrk=order_dlq" {
      class: [dlq]
    }
  }

  payment: "payment (quorum)" {
    q: payment_queue {
      class: [workq]
    }
    svc: payment-service {
      class: [service]
    }
    retry: "delayed retry\n5s × 3" {
      class: [delay]
    }
    dead: payment_dlq {
      class: [deadq]
    }

    q -> svc: consume order_created {
      class: [happy]
    }
    q -> retry: reject requeue {
      class: [retry]
    }
    retry -> q: redeliver {
      class: [retry]
    }
    q -> dead: "DLE amq.default\nrk=payment_dlq" {
      class: [dlq]
    }
  }

  notification: "notification (quorum)" {
    q: notification_queue {
      class: [workq]
    }
    svc: notification-service {
      class: [service]
    }
    retry: "delayed retry\n5s × 3" {
      class: [delay]
    }
    dead: notification_dlq {
      class: [deadq]
    }

    q -> svc: "consume order_created\nconsume send_payment_notification" {
      class: [happy]
    }
    q -> retry: reject requeue {
      class: [retry]
    }
    retry -> q: redeliver {
      class: [retry]
    }
    q -> dead: "DLE amq.default\nrk=notification_dlq" {
      class: [dlq]
    }
  }
}

client -> gateway: POST /api/order {
  class: [happy]
}

gateway -> rmq.exchanges.default: emit order_created {
  class: [happy]
}
rmq.exchanges.default -> rmq.order.q: rk=order_queue {
  class: [happy]
}

rmq.order.svc -> rmq.exchanges.fanout: publishFanout\norder_created {
  class: [happy]
}
rmq.exchanges.fanout -> rmq.payment.q: bind "" {
  class: [happy]
}
rmq.exchanges.fanout -> rmq.notification.q: bind "" {
  class: [happy]
}

rmq.payment.svc -> rmq.exchanges.default: emit send_payment_notification {
  class: [happy]
}
rmq.exchanges.default -> rmq.notification.q: rk=notification_queue {
  class: [happy]
}
