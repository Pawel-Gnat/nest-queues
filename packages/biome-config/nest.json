{
	"$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
	"root": false,
	"extends": ["./biome.json"],
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"overrides": [
		{
			"includes": [
				"src/**/*.controller.ts",
				"src/**/*.interceptor.ts",
				"src/**/*.module.ts",
				"src/**/*.service.ts",
				"src/**/*.store.ts",
				"src/**/*.strategy.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"useImportType": "off"
					}
				}
			}
		}
	]
}
